# Copy to .env. Use unique strong passwords before deployment.
POSTGRES_PASSWORD=replace-with-a-random-db-password
DATABASE_URL=postgresql+psycopg://campus:replace-with-a-random-db-password@postgres:5432/campus
REDIS_URL=redis://redis:6379/0
STORAGE_DIR=/data/files
MODEL_MODE=mock
PUBLIC_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
DEMO_STUDENT_PASSWORD=replace-with-a-student-password
DEMO_ADMIN_PASSWORD=replace-with-an-admin-password
RETRIEVAL_MODE=hybrid
EMBEDDING_DIMENSIONS=1024
MAX_CONTEXT_CHARS=8000
CHUNK_SIZE=1200
CHUNK_OVERLAP=120
CHUNK_MIN_CHARS=300
CHUNK_POLICY=semantic-v2
MATERIAL_MAX_TOKENS=8192
RETRIEVAL_TOP_K=6
JOB_TIMEOUT_SECONDS=600
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_API_STYLE=deepseek
LLM_THINKING_ENABLED=false
LLM_REASONING_EFFORT=
# Optional: LLM_MAX_COMPLETION_TOKENS=4096
EMBEDDING_API_BASE=http://embedding:80/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_SEND_DIMENSIONS=false

# Mock startup does not download the optional embedding model.
COMPOSE_PROFILES=
EMBEDDING_REQUIRES_API_KEY=false
EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181

RATE_LIMIT_ENABLED=true
LOGIN_PER_MINUTE=60
LOGIN_ACCOUNT_PER_MINUTE=10
AI_PER_MINUTE=20
AI_DAILY_REQUESTS=200
UPLOAD_PER_MINUTE=10
USER_CONCURRENT_REQUESTS=2
USER_ACTIVE_JOBS=3
# Optional JSON: model -> input/output CNY per million tokens. Empty means unknown cost.
MODEL_PRICES={}
