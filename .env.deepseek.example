# Overlay selected fields into the existing .env; preserve database/account settings.
# DeepSeek chat plus local Docker CPU BGE-M3 embedding.
MODEL_MODE=mock
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_API_STYLE=deepseek
LLM_THINKING_ENABLED=false
LLM_REASONING_EFFORT=
LLM_MAX_COMPLETION_TOKENS=4096
EMBEDDING_API_BASE=http://embedding:80/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
# Set false only when the provider returns native 1024-dimensional vectors.
EMBEDDING_SEND_DIMENSIONS=false
PROVIDER_TIMEOUT=60

COMPOSE_PROFILES=bge
EMBEDDING_REQUIRES_API_KEY=false
EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
